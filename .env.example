# انسخه باسم .env واملأه. ملف .env مستثنى من جيت.
# ═══════════════════════════════════════════════════════════════════
#  كله على الطبقات المجانية. مفيش حاجة مدفوعة في السطور دي.
# ═══════════════════════════════════════════════════════════════════

# ── ١) قاعدة البيانات ──────────────────────────────────────────────
# محليًا — ملف على الجهاز، مش محتاج أي حساب:
DATABASE_URI=file:./alrowad.db
#
# للنشر — Postgres مجاني. الكود بيبدّل لوحده حسب أول الرابط.
#
#   Supabase (المفضّل): حساب واحد بيديك قاعدة بيانات + تخزين صور
#     supabase.com ← New project ← Region: eu-central-1 (Frankfurt)
#     Settings ← Database ← Connection string ← Transaction pooler
#   DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
#   أو Neon:
#     neon.tech ← New Project ← Region: eu-central-1
#     Connection string ← Pooled connection (اللي فيه -pooler)
#   DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── ٢) سر التوقيع ──────────────────────────────────────────────────
# ولّده بـ:  openssl rand -base64 32
PAYLOAD_SECRET=

# ── ٣) حساب المدير ─────────────────────────────────────────────────
# اكتبهم وشغّل:  npm run admin
# نفس الأمر بيغيّر كلمة المرور لو الحساب موجود («نسيت كلمة المرور»).
ADMIN_EMAIL=admin@alrowadrealestate.com
ADMIN_PASSWORD=
ADMIN_NAME=مدير الموقع

# ── ٤) تخزين الصور — للنشر بس ──────────────────────────────────────
# سيبهم فاضيين محليًا: الصور بتتحفظ على الجهاز في public/uploads.
# على استضافة سيرفرلس مفيش قرص دائم، فلازم تخزين خارجي.
#
#   Supabase Storage (١ جيجا مجانًا، نفس حساب قاعدة البيانات):
#     Storage ← New bucket اسمه media ← خليه Public
#     Settings ← Storage ← S3 connection ← New access key
#   Note storage.supabase.co, not the plain project host — Supabase documents
#   the former as considerably faster for large uploads.
#   S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
#   S3_REGION=eu-central-1
#
#   أو Cloudflare R2 (١٠ جيجا مجانًا):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── ٥) الموقع ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3100
