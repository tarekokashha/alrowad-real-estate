{
  "name": "alrowad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "seed": "node --env-file=.env --no-deprecation --import tsx scripts/seed.ts",
    "admin": "node --env-file=.env --no-deprecation --import tsx scripts/admin.ts",
    "harden:db": "node scripts/harden-db.mjs",
    "vercel:env": "node scripts/push-env.mjs",
    "cms:check": "node --env-file=.env --no-deprecation --import tsx scripts/verify-cms.ts",
    "storage:check": "node scripts/check-storage.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "dev:local": "cross-env DATABASE_URI=file:./admin-dev.db PAYLOAD_SECRET=local-dev-only-secret-not-production next dev -p 3300"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
